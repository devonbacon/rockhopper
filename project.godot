; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

boot_splash/bg_color=Color(0.012, 0.016, 0.039, 1)
boot_splash/show_image=false
config/name="Rockhopper"
config/icon="res://icon.svg"
run/main_scene="res://menu/menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Net="*res://net/net.gd"
Music="*res://audio/music.gd"
Sfx="*res://audio/sfx.gd"
SoundEditor="*res://ui/sound_editor/sound_editor.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/size/initial_position_type=4
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg")

[physics]

3d/default_gravity=0.0

[rendering]

renderer/rendering_method.web="gl_compatibility"
lights_and_shadows/directional_shadow/size=8192
anti_aliasing/quality/msaa_3d=1
